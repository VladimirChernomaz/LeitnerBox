<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonForward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/direction_forward"
        android:backgroundTint="@color/primary"
        android:textColor="@color/text_on_primary"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/buttonReverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/direction_reverse"
        android:backgroundTint="@color/primary"
        android:textColor="@color/text_on_primary"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/buttonMixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/direction_mixed"
        android:backgroundTint="@color/accent"
        android:textColor="@color/text_on_primary"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonWords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_words"
        android:backgroundTint="#757575"
        android:textColor="@color/text_on_primary" />

</LinearLayout>
